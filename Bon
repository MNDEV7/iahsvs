-- helpers defined first so everything below can call them
local function getAttachPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(names, p.Name) end
    end
    return names
end

local function getAttachTeamNames()
    local names = {}
    for _, t in ipairs(Teams:GetTeams()) do
        table.insert(names, t.Name)
    end
    return names
end

local AttachSection = AttachTab:Section({
    Title  = "⛓️ Attach Player",
    Box    = false,
    Opened = true,
})

local AttachToggle = AttachSection:Toggle({
    Title    = "Attach",
    Desc     = "Glide and lock onto the selected player (or nearest valid if none picked).",
    Default  = false,
    Callback = function(state)
        if state then attachStart() else attachStop() end
    end,
})

AttachSection:Input({
    Title       = "Attach Distance",
    Desc        = "Studs behind the target to hover at (default: 3.0).",
    Placeholder = "Default: 3.0",
    Callback    = function(v)
        local n = tonumber(v)
        if n and n >= 0 then ATTACH_DIST = n end
    end,
})

AttachSection:Input({
    Title       = "Glide Speed",
    Desc        = "Studs per second toward the target (default: 60).",
    Placeholder = "Default: 60",
    Callback    = function(v)
        local n = tonumber(v)
        if n and n > 0 then GLIDE_SPEED = n end
    end,
})

AttachSection:Input({
    Title       = "Jitter Range",
    Desc        = "Shake intensity to help evade detection (default: 0.30).",
    Placeholder = "Default: 0.30",
    Callback    = function(v)
        local n = tonumber(v)
        if n and n >= 0 then JITTER_RANGE = n end
    end,
})

AttachSection:Input({
    Title       = "Scan Interval",
    Desc        = "Seconds between target rescans (default: 0.3).",
    Placeholder = "Default: 0.3",
    Callback    = function(v)
        local n = tonumber(v)
        if n and n > 0 then SCAN_INTERVAL = n end
    end,
})

AttachSection:Button({
    Title    = "Reset Attach Settings",
    Desc     = "Stop attach and restore all settings to default.",
    Callback = function()
        attachStop()
        ATTACH_DIST      = 3.0
        GLIDE_SPEED      = 60
        JITTER_RANGE     = 0.30
        SCAN_INTERVAL    = 0.3
        attachPinned     = {}
        attachTeamFilter = {}
        AttachToggle:Set(false)
        AttachPlayerDropdown:Refresh(getAttachPlayerNames(), {})
        AttachTeamDropdown:Refresh(getAttachTeamNames(), {})
        WindUI:Notify({
            Title    = "⛓️ Attach Reset",
            Content  = "Attach stopped and settings restored to default.",
            Icon     = "solar:refresh-bold",
            Duration = 3,
        })
    end,
})

-- ============================================================
-- ATTACH — SECTION: Choose Team (Player & Team dropdowns)
-- ============================================================
local ChooseTeamSection = AttachTab:Section({
    Title  = "👥 Choose Team",
    Box    = false,
    Opened = true,
})

local AttachPlayerDropdown = ChooseTeamSection:Dropdown({
    Title     = "Choose Player",
    Desc      = "Pick one or more players to target. Leave blank to target all players (or filter by team below).",
    Values    = getAttachPlayerNames(),
    Value     = {},
    Multi     = true,
    AllowNone = true,
    Callback  = function(selected)
        attachPinned = {}
        if type(selected) == "table" then
            for _, name in pairs(selected) do attachPinned[name] = true end
        elseif type(selected) == "string" and selected ~= "" then
            attachPinned[selected] = true
        end
    end,
})

Players.PlayerAdded:Connect(function()
    task.wait(0.1)
    AttachPlayerDropdown:Refresh(getAttachPlayerNames(), {})
end)
Players.PlayerRemoving:Connect(function(p)
    attachPinned[p.Name] = nil
    task.wait(0.1)
    AttachPlayerDropdown:Refresh(getAttachPlayerNames(), {})
end)

local AttachTeamDropdown = ChooseTeamSection:Dropdown({
    Title     = "Choose Team",
    Desc      = "Restrict targeting to players on these teams. Leave blank to allow all teams.",
    Values    = getAttachTeamNames(),
    Value     = {},
    Multi     = true,
    AllowNone = true,
    Callback  = function(selected)
        attachTeamFilter = {}
        if type(selected) == "table" then
            for _, v in pairs(selected) do attachTeamFilter[v] = true end
        elseif type(selected) == "string" and selected ~= "" then
            attachTeamFilter[selected] = true
        end
    end,
})

Teams.ChildAdded:Connect(function(c)
    if c:IsA("Team") then
        task.wait(0.1)
        AttachTeamDropdown:Refresh(getAttachTeamNames(), {})
    end
end)
Teams.ChildRemoved:Connect(function(c)
    if c:IsA("Team") then
        attachTeamFilter = {}
        AttachTeamDropdown:Refresh(getAttachTeamNames(), {})
    end
end)
