local function healIsTeamAllowed(p)
    if next(healTeamFilter) == nil then return true end  -- empty = everyone
    local teamName = p.Team and p.Team.Name
    if not teamName then return false end
    return healTeamFilter[teamName] == true
end

local function healGetTarget()
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not healCharsFolder then return nil end
    local best, bestDist = nil, HEAL.MaxDistance
    for _, charModel in ipairs(healCharsFolder:GetChildren()) do
        if charModel == myChar then continue end
        local hum = charModel:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and hum.Health < hum.MaxHealth then
            local tRoot = charModel:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local dist = (myRoot.Position - tRoot.Position).Magnitude
                if dist < bestDist then
                    local tp = Players:GetPlayerFromCharacter(charModel)
                    if tp and healIsTeamAllowed(tp) then
                        best = tp; bestDist = dist
                    end
                end
            end
        end
    end
    return best
end

local function healGetTool(backpack, char)
    local now = workspace:GetServerTimeNow()
    for _, name in ipairs(MEDICAL_TOOLS) do
        local t = backpack:FindFirstChild(name) or char:FindFirstChild(name)
        if t then
            local ready    = t:GetAttribute("Ready")
            local cooldown = t:GetAttribute("Cooldown") or 0
            if ready ~= false and now >= cooldown then return t end
        end
    end
    -- fallback — return any tool found
    for _, name in ipairs(MEDICAL_TOOLS) do
        local t = backpack:FindFirstChild(name) or char:FindFirstChild(name)
        if t then return t end
    end
    return nil
end

