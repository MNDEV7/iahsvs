-- Local character references (refreshed on respawn)
local tpChar, tpHum, tpRoot, tpCamera

local function refreshTpwalkRefs(char)
    tpChar   = char
    tpHum    = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
    tpRoot   = (tpHum and tpHum.RootPart) or char:WaitForChild("HumanoidRootPart", 10)
