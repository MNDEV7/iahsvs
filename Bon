-- REACH — STATE & CONFIG
-- ============================================================
local CBRING = {
    Enabled       = false,
    MaxDistance   = 25,
    ForwardOffset = 3.5,
}

local reachTeamFilter    = {}   -- [teamName] = true; empty = all teams
local reachHostileOnly   = false
local reachCurrentTarget = nil
local reachActiveJoints  = {}
local reachModifiedTools = {}

-- ============================================================
-- REACH — CORE LOGIC
-- ============================================================
local function reachRestoreLimbs(p)
    if reachModifiedTools[p] then
        for part, original in pairs(reachModifiedTools[p]) do
            if part and part.Parent then
                part.CanCollide = original.CanCollide
                part.CanTouch   = original.CanTouch
            end
        end
        reachModifiedTools[p] = nil
    end
    if reachActiveJoints[p] then
        local data = reachActiveJoints[p]
        if data.LeftShoulder  and data.LeftShoulder.Parent  then data.LeftShoulder.Enabled  = true end
        if data.RightShoulder and data.RightShoulder.Parent then data.RightShoulder.Enabled = true end
        reachActiveJoints[p] = nil
    end
end

local function reachIsTargetable(p)
    if p == player then return false end
    local char = p.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    -- Hostile-only filter
    if reachHostileOnly then
        local PatientTeam2 = Teams:FindFirstChild("PATIENT")
        if not PatientTeam2 then return false end
        if p.Team ~= PatientTeam2 then return false end
        if p:GetAttribute("IsTagged") ~= true then return false end
    end
    -- Team filter (empty = everyone)
    if next(reachTeamFilter) ~= nil then
        local teamName = p.Team and p.Team.Name
        if not teamName then return false end
        if not reachTeamFilter[teamName] then return false end
    end
    return true
end

local function reachGetClosest()
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best, bestDist = nil, CBRING.MaxDistance
    for _, p in ipairs(Players:GetPlayers()) do
        if not reachIsTargetable(p) then continue end
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if root and hum and hum.Health > 0 then
            local dist = (myRoot.Position - root.Position).Magnitude
            if dist < bestDist then bestDist = dist; best = p end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if not CBRING.Enabled then
        if reachCurrentTarget then
            reachRestoreLimbs(reachCurrentTarget)
            reachCurrentTarget = nil
        end
        return
    end

    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local targetPlayer = reachGetClosest()

    if targetPlayer ~= reachCurrentTarget then
        if reachCurrentTarget then reachRestoreLimbs(reachCurrentTarget) end
        reachCurrentTarget = targetPlayer
    end

    if not targetPlayer then return end

    local tChar     = targetPlayer.Character
    local tHum      = tChar and tChar:FindFirstChildOfClass("Humanoid")
    local tTorso    = tChar and tChar:FindFirstChild("Torso")
    local tLeftArm  = tChar and tChar:FindFirstChild("Left Arm")
    local tRightArm = tChar and tChar:FindFirstChild("Right Arm")

    if tHum and tHum.Health > 0 and tTorso and tLeftArm and tRightArm then
        local ls = tTorso:FindFirstChild("Left Shoulder")
        local rs = tTorso:FindFirstChild("Right Shoulder")
        if ls and rs then
            if not reachActiveJoints[targetPlayer] then
                reachActiveJoints[targetPlayer] = { LeftShoulder = ls, RightShoulder = rs }
            end
            ls.Enabled = false
            rs.Enabled = false

            if not reachModifiedTools[targetPlayer] then reachModifiedTools[targetPlayer] = {} end
            local equippedTool = tChar:FindFirstChildOfClass("Tool")
            if equippedTool then
                for _, desc in ipairs(equippedTool:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        if not reachModifiedTools[targetPlayer][desc] then
                            reachModifiedTools[targetPlayer][desc] = {
                                CanCollide = desc.CanCollide,
                                CanTouch   = desc.CanTouch,
                            }
                        end
                        desc.CanCollide = false
                        desc.CanTouch   = false
                    end
                end
            end

            local targetCFrame = myRoot.CFrame * CFrame.new(0, 0, -CBRING.ForwardOffset)
            tLeftArm.CFrame  = targetCFrame * CFrame.new(-0.6, 0, 0)
            tRightArm.CFrame = targetCFrame * CFrame.new( 0.6, 0, 0)
        end
    else
        reachRestoreLimbs(targetPlayer)
        reachCurrentTarget = nil
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if p == reachCurrentTarget then
        reachRestoreLimbs(p)
        reachCurrentTarget = nil
    end
end)

