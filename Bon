local HostileSection = VisualsTab:Section({
    Title  = "💢 Hostile Tracking",
    Box    = false,
    Opened = true,
})

-- ── State ────────────────────────────────────────────────
local tracerEnabled = false
local tracerCache   = {}

local PatientTeam = Teams:FindFirstChild("PATIENT")
-- Re-fetch if teams load after script
if not PatientTeam then
    Teams.ChildAdded:Connect(function(c)
        if c:IsA("Team") and c.Name == "PATIENT" then
            PatientTeam = c
        end
    end)
end

local function isHostilePatient(p)
    if not p or p == player then return false end
    if not PatientTeam then return false end
    if p.Team ~= PatientTeam then return false end
    if p:GetAttribute("IsTagged") ~= true then return false end
    return true
end

local function tracerCreate(p)
    if p == player then return end
    local t = {}
    t.Outline             = Drawing.new("Line")
    t.Outline.Visible     = false
    t.Outline.Color       = Color3.fromRGB(0, 0, 0)
    t.Outline.Thickness   = 3
    t.Outline.Transparency = 1
    t.Line                = Drawing.new("Line")
    t.Line.Visible        = false
    t.Line.Color          = Color3.fromRGB(255, 0, 0)
    t.Line.Thickness      = 1
    t.Line.Transparency   = 1
    tracerCache[p] = t
end

local function tracerRemove(p)
    if tracerCache[p] then
        for _, d in pairs(tracerCache[p]) do pcall(function() d:Remove() end) end
        tracerCache[p] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do tracerCreate(p) end
Players.PlayerAdded:Connect(tracerCreate)
Players.PlayerRemoving:Connect(tracerRemove)

RunService.RenderStepped:Connect(function()
    if not tracerEnabled then return end
    local vp     = Camera.ViewportSize
    local origin = Vector2.new(vp.X / 2, vp.Y)
    for p, t in pairs(tracerCache) do
        if isHostilePatient(p) then
            local char = p.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local screenPos, onScreen = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
                if onScreen then
                    local target = Vector2.new(screenPos.X, screenPos.Y)
                    t.Outline.From    = origin
                    t.Outline.To      = target
                    t.Outline.Visible = true
                    t.Line.From       = origin
                    t.Line.To         = target
                    t.Line.Visible    = true
                else
                    t.Outline.Visible = false
                    t.Line.Visible    = false
                end
            else
                t.Outline.Visible = false
                t.Line.Visible    = false
            end
        else
            t.Outline.Visible = false
            t.Line.Visible    = false
        end
    end
end)

