-- ── State ────────────────────────────────────────────────
local hlConfig = {
    Enabled      = false,
    SelectedTeams = {},
    FillAlpha    = 0.55,
    OutlineAlpha = 0,
    UseTeamColor = true,
    CustomFill   = Color3.fromRGB(255, 80, 80),
    CustomOutline = Color3.fromRGB(255, 255, 255),
}
local hlInstances = {}   -- [Player] = Highlight

-- ── Core logic ───────────────────────────────────────────
local function hlShouldShow(p)
    if not hlConfig.Enabled then return false end
    local teamName = p.Team and p.Team.Name
    if not teamName then return false end
    for _, n in ipairs(hlConfig.SelectedTeams) do
        if n == teamName then return true end
    end
    return false
end

local function hlApply(p)
    if p == player then return end
    local char = p.Character
    if not char then return end
    if hlInstances[p] then
        pcall(function() hlInstances[p]:Destroy() end)
        hlInstances[p] = nil
    end
    if not hlShouldShow(p) then return end
    local col = (hlConfig.UseTeamColor and p.Team)
        and p.TeamColor.Color or hlConfig.CustomFill
    local hl = Instance.new("Highlight")
    hl.FillTransparency    = hlConfig.FillAlpha
    hl.OutlineTransparency = hlConfig.OutlineAlpha
    hl.FillColor           = col
    hl.OutlineColor        = hlConfig.UseTeamColor and col or hlConfig.CustomOutline
    hl.Adornee             = char
    hl.Parent              = char
    hlInstances[p]         = hl
end

local function hlRemove(p)
    if hlInstances[p] then
        pcall(function() hlInstances[p]:Destroy() end)
        hlInstances[p] = nil
    end
end

local function hlRefreshAll()
    for _, p in ipairs(Players:GetPlayers()) do hlApply(p) end
end

local function hlClearAll()
    for p, hl in pairs(hlInstances) do
        pcall(function() hl:Destroy() end)
        hlInstances[p] = nil
    end
end

local function hlHookPlayer(p)
    if p == player then return end
    if p.Character then hlApply(p) end
    p.CharacterAdded:Connect(function()
        task.wait(0.1); hlApply(p)
    end)
    p.CharacterRemoving:Connect(function()
        hlInstances[p] = nil
    end)
    p:GetPropertyChangedSignal("Team"):Connect(function()
        task.wait(0.1); hlApply(p)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do hlHookPlayer(p) end
Players.PlayerAdded:Connect(hlHookPlayer)
Players.PlayerRemoving:Connect(hlRemove)

task.spawn(function()
    while true do task.wait(3); hlRefreshAll() end
end)

