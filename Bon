local function setLockColor(col)
    ringStroke.Color           = col
    lineH.BackgroundColor3     = col
    lineV.BackgroundColor3     = col
    centerDot.BackgroundColor3 = col
    innerStroke.Color          = col
    pcStroke.Color             = col
    pcLabel.TextColor3         = col
end

local function isTargetable(p)
    if p == player then return false end
    -- if no teams selected in dropdown, target everyone
    if next(lockTeamFilter) == nil then return true end
    local teamName = p.Team and p.Team.Name
    if not teamName then return false end
    return lockTeamFilter[teamName] == true
end

local function getLockPart(char)
    return char:FindFirstChild(lockTargetPart)
        or char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("Head")
end

local function findLockTarget()
    local myChar = player.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local center = Camera.ViewportSize / 2
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if not isTargetable(p) then continue end
        local char = p.Character
        if not char then continue end
        local part = getLockPart(char)
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not part or not hum or hum.Health <= 0 then continue end
        if (part.Position - myRoot.Position).Magnitude > LockConfig.LOCK_DISTANCE then continue end
        local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
        if not onScreen then continue end
        local dx, dy     = screenPos.X - center.X, screenPos.Y - center.Y
        local screenDist = math.sqrt(dx*dx + dy*dy)
        if screenDist > LockConfig.FOV_RADIUS then continue end
        if screenDist < bestDist then bestDist = screenDist; best = part end
    end
    return best
end

local function validateLockTarget()
    if not lockedTarget then return end
    pcall(function()
        local char   = lockedTarget.Parent
        if not char or not char.Parent then locked = false; lockedTarget = nil; return end
        local hum    = char:FindFirstChildOfClass("Humanoid")
        local myChar = player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 then locked = false; lockedTarget = nil; return end
        if not myRoot then locked = false; lockedTarget = nil; return end
        if (lockedTarget.Position - myRoot.Position).Magnitude > LockConfig.LOCK_DISTANCE then
            locked = false; lockedTarget = nil; return
        end
        local owner = Players:GetPlayerFromCharacter(char)
        if owner and not isTargetable(owner) then locked = false; lockedTarget = nil end
    end)
end

local function doLockToggle()
    if not lockEnabled then return end
    if locked then
        locked = false; lockedTarget = nil
        setLockColor(LockConfig.COLOR_IDLE)
        ring.BackgroundTransparency = 0.3
        pcLabel.Text = "  [Q]  Lock-On: OFF"
    else
        local target = findLockTarget()
        if target then
            locked = true; lockedTarget = target
            setLockColor(LockConfig.COLOR_LOCKED)
            ring.BackgroundTransparency = 0.15
            pcLabel.Text = "  [Q]  Lock-On: ON"
        end
    end
end

