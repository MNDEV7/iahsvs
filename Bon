-- ── Float ─────────────────────────────────────────────────
local floatEnabled     = false
local floatConnection  = nil
local floatPlatform    = nil

local function createFloatPlatform()
    -- Clean up any stale instance first
    if workspace:FindFirstChild(floatName) then
        workspace[floatName]:Destroy()
    end

    floatPlatform             = Instance.new("Part")
    floatPlatform.Name        = floatName
    floatPlatform.Size        = Vector3.new(10, 0.5, 10)
    floatPlatform.Color       = Color3.fromRGB(0, 255, 255)
    floatPlatform.Transparency = 0.85
    floatPlatform.Material    = Enum.Material.ForceField
    floatPlatform.Anchored    = true
    floatPlatform.CanCollide  = true
    floatPlatform.Parent      = workspace
    return floatPlatform
end

local function destroyFloatPlatform()
    if floatPlatform then
        floatPlatform:Destroy()
        floatPlatform = nil
    end
    if workspace:FindFirstChild(floatName) then
        workspace[floatName]:Destroy()
    end
end

local function enableFloat()
    local char  = player.Character or player.CharacterAdded:Wait()
    local root  = char:WaitForChild("HumanoidRootPart")
    local hum   = char:WaitForChild("Humanoid")
    local platform = createFloatPlatform()
    local currentFloatHeight = root.Position.Y - 3.25

    floatConnection = RunService.RenderStepped:Connect(function()
        if not floatEnabled then return end
        if not (char and root and hum) then return end
        local velY = root.AssemblyLinearVelocity.Y
        if velY > 0.1 then
            currentFloatHeight = root.Position.Y - 3.25
        end
        platform.CFrame = CFrame.new(root.Position.X, currentFloatHeight, root.Position.Z)
    end)
end

local function disableFloat()
    if floatConnection then
        floatConnection:Disconnect()
        floatConnection = nil
    end
    destroyFloatPlatform()
end

