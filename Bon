-- ATTACH — CONFIG (mutable by inputs)
-- ============================================================
local ATTACH_DIST   = 3.0
local GLIDE_SPEED   = 60
local JITTER_RANGE  = 0.30
local SCAN_INTERVAL = 0.3

-- ============================================================
-- ATTACH — STATE
-- ============================================================
local attachRunning     = false
local attachNoclipConn  = nil
local attachTarget      = nil   -- resolved Player object (updated by scanner)
local attachPinned      = {}    -- [playerName]=true; empty = use nearest
local attachTeamFilter  = {}    -- [teamName]=true; empty = all teams

-- ============================================================
-- ATTACH — CORE LOGIC
-- ============================================================
local function attachIsValid(p)
    if p == player then return false end
    local char = p.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then return false end
    if next(attachTeamFilter) ~= nil then
        local tn = p.Team and p.Team.Name
        if not tn or not attachTeamFilter[tn] then return false end
    end
    return true
end

local function attachGetNearest()
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if attachIsValid(p) then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local d = (myRoot.Position - root.Position).Magnitude
                if d < bestDist then bestDist = d; best = p end
            end
        end
    end
    return best
end

local function attachResolve()
    -- If specific players are pinned, pick the nearest valid one among them
    if next(attachPinned) ~= nil then
        local myChar = player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local best, bestDist = nil, math.huge
        for name, _ in pairs(attachPinned) do
            local p = Players:FindFirstChild(name)
            if p and attachIsValid(p) then
                if myRoot then
                    local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local d = (myRoot.Position - root.Position).Magnitude
                        if d < bestDist then bestDist = d; best = p end
                    end
                else
                    best = p; break
                end
            end
        end
        if best then return best end
    end
    return attachGetNearest()
end

local function attachDoNoclip()
    if attachNoclipConn then attachNoclipConn:Disconnect() end
    attachNoclipConn = RunService.Stepped:Connect(function()
        local char = player.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = false end)
            end
        end
    end)
end

local function attachCleanup()
    if attachNoclipConn then attachNoclipConn:Disconnect(); attachNoclipConn = nil end
    local char = player.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = true end)
            end
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            local bv = root:FindFirstChild("GlideVelocity")
            if bv then bv:Destroy() end
        end
    end
    attachTarget  = nil
end

local function attachStop()
    attachRunning = false
    attachCleanup()
end

local function attachStart()
    attachRunning = true
    attachDoNoclip()

    -- Scanner loop
    task.spawn(function()
        while attachRunning do
            attachTarget = attachResolve()
            task.wait(SCAN_INTERVAL)
        end
    end)

    -- Glide engine
    task.spawn(function()
        while attachRunning do
            local dt = RunService.Heartbeat:Wait()
            if not attachRunning then break end

            local myChar = player.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then continue end

            local tgt = attachTarget
            if tgt and tgt.Character then
                local tChar = tgt.Character
                local tRoot = tChar:FindFirstChild("HumanoidRootPart")
                local tHum  = tChar:FindFirstChildOfClass("Humanoid")

                if tRoot and tHum and tHum.Health > 0 then
                    local tPos    = tRoot.Position
                    local tLook   = tRoot.CFrame.LookVector
                    local goalPos = tPos - (tLook * ATTACH_DIST)
                    local currPos = myRoot.Position
                    local dirVec  = goalPos - currPos
                    local dist    = dirVec.Magnitude

                    local jitter = Vector3.new(
                        math.random(-100,100)/100 * JITTER_RANGE,
                        math.random(-100,100)/100 * JITTER_RANGE,
                        math.random(-100,100)/100 * JITTER_RANGE
                    )

                    if dist > 5 then
                        local step    = GLIDE_SPEED * dt
                        local nextPos = currPos + (dirVec.Unit * math.min(step, dist))
                        myRoot.CFrame = CFrame.lookAt(nextPos + jitter, tPos)
                        myRoot.AssemblyLinearVelocity = dirVec.Unit * GLIDE_SPEED
                    else
                        myRoot.CFrame = CFrame.lookAt(goalPos + jitter, tPos)
                        myRoot.AssemblyLinearVelocity = tRoot.AssemblyLinearVelocity
                    end
                else
                    attachTarget = nil
                end
            else
                myRoot.AssemblyLinearVelocity = Vector3.zero
            end
        end
        attachCleanup()
    end)
end

