local function taserIsHostile(p)
    if not p or p == player then return false end
    if not OrdPatientTeam then return false end
    if p.Team ~= OrdPatientTeam then return false end
    if p:GetAttribute("IsTagged") ~= true then return false end
    local char = p.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local part = char and char:FindFirstChild(TASER_SA.TargetPart)
    if not hum or hum.Health <= 0 or not root or not part then return false end
    return true
end

local function taserGetClosest()
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best, bestDist = nil, TASER_SA.MaxDistance
    for _, p in ipairs(Players:GetPlayers()) do
        if taserIsHostile(p) then
            local char = p.Character
            local part = char:FindFirstChild(TASER_SA.TargetPart)
            if part then
                local dist = (myRoot.Position - char.HumanoidRootPart.Position).Magnitude
                if dist < bestDist then bestDist = dist; best = part end
            end
        end
    end
    return best
end

-- Hook GetMouseHit and Mouse.Hit metamethod
local taserOldGetMouseHit = nil
local taserHooked = false

local function taserHook()
    if taserHooked then return end
    taserHooked = true
    local ok = pcall(function()
        taserOldGetMouseHit = hookfunction(UserInputService.GetMouseHit, function(self, ...)
            if TASER_SA.Enabled then
                local part = taserGetClosest()
                if part then return CFrame.new(part.Position) end
            end
            return taserOldGetMouseHit(self, ...)
        end)
    end)
    if not ok then
        local rawMeta = getrawmetatable(game)
        if rawMeta and rawMeta.__index then
            local oldIndex = rawMeta.__index
            if setreadonly then setreadonly(rawMeta, false) end
            rawMeta.__index = newcclosure(function(self, key)
                if TASER_SA.Enabled and (key == "Hit" or key == "hit") and self:IsA("Mouse") then
                    local part = taserGetClosest()
                    if part then return CFrame.new(part.Position) end
                end
                return oldIndex(self, key)
            end)
            if setreadonly then setreadonly(rawMeta, true) end
        end
    end
end

