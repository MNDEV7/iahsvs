-- ── State ────────────────────────────────────────────────
local boxEnabled    = false
local healthEnabled = false
local espCache      = {}

local function espCreate(p)
    if p == player then return end
    local esp = {}
    -- Box outline
    esp.BoxOutline             = Drawing.new("Square")
    esp.BoxOutline.Visible     = false
    esp.BoxOutline.Color       = Color3.fromRGB(0, 0, 0)
    esp.BoxOutline.Thickness   = 3
    esp.BoxOutline.Transparency = 1
    esp.BoxOutline.Filled      = false
    -- Box fill
    esp.Box                    = Drawing.new("Square")
    esp.Box.Visible            = false
    esp.Box.Color              = Color3.fromRGB(255, 255, 255)
    esp.Box.Thickness          = 1
    esp.Box.Transparency       = 1
    esp.Box.Filled             = false
    -- Health bar outline
    esp.HealthOutline             = Drawing.new("Square")
    esp.HealthOutline.Visible     = false
    esp.HealthOutline.Color       = Color3.fromRGB(0, 0, 0)
    esp.HealthOutline.Thickness   = 1
    esp.HealthOutline.Transparency = 1
    esp.HealthOutline.Filled      = true
    -- Health bar fill
    esp.HealthBar                 = Drawing.new("Square")
    esp.HealthBar.Visible         = false
    esp.HealthBar.Color           = Color3.fromRGB(0, 255, 0)
    esp.HealthBar.Thickness       = 1
    esp.HealthBar.Transparency    = 1
    esp.HealthBar.Filled          = true
    -- Health text
    esp.HealthText                = Drawing.new("Text")
    esp.HealthText.Visible        = false
    esp.HealthText.Color          = Color3.fromRGB(255, 255, 255)
    esp.HealthText.Size           = 13
    esp.HealthText.Center         = true
    esp.HealthText.Outline        = true
    esp.HealthText.OutlineColor   = Color3.fromRGB(0, 0, 0)
    espCache[p] = esp
end

local function espRemove(p)
    if espCache[p] then
        for _, d in pairs(espCache[p]) do pcall(function() d:Remove() end) end
        espCache[p] = nil
    end
end

local function espHideAll(p)
    if not espCache[p] then return end
    local esp = espCache[p]
    esp.Box.Visible          = false
    esp.BoxOutline.Visible   = false
    esp.HealthOutline.Visible = false
    esp.HealthBar.Visible    = false
    esp.HealthText.Visible   = false
end

for _, p in ipairs(Players:GetPlayers()) do espCreate(p) end
Players.PlayerAdded:Connect(espCreate)
Players.PlayerRemoving:Connect(espRemove)

-- Single shared render loop for both box and health bar
RunService.RenderStepped:Connect(function()
    if not boxEnabled and not healthEnabled then return end
    for p, esp in pairs(espCache) do
        local char = p.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp      = char.HumanoidRootPart
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local dist  = (Camera.CFrame.Position - hrp.Position).Magnitude
                local sizeX = math.clamp(2000 / dist, 10, 300)
                local sizeY = math.clamp(3000 / dist, 15, 450)
                local boxPos = Vector2.new(screenPos.X - sizeX / 2, screenPos.Y - sizeY / 2)

                -- Box ESP
                esp.Box.Size         = Vector2.new(sizeX, sizeY)
                esp.Box.Position     = boxPos
                esp.Box.Visible      = boxEnabled
                esp.BoxOutline.Size     = Vector2.new(sizeX, sizeY)
                esp.BoxOutline.Position = boxPos
                esp.BoxOutline.Visible  = boxEnabled

                -- Health bar
                local health       = humanoid and humanoid.Health    or 0
                local maxHealth    = humanoid and humanoid.MaxHealth  or 100
                local hPercent     = math.clamp(health / maxHealth, 0, 1)
                local barW, barH   = 4, sizeY
                local barOffset    = 6
                local barPos       = Vector2.new(boxPos.X - barOffset, boxPos.Y)
                local curBarHeight = barH * hPercent

                esp.HealthOutline.Size     = Vector2.new(barW, barH)
                esp.HealthOutline.Position = barPos
                esp.HealthOutline.Visible  = healthEnabled

                esp.HealthBar.Size     = Vector2.new(barW - 2, curBarHeight - 2)
                esp.HealthBar.Position = Vector2.new(barPos.X + 1, barPos.Y + (barH - curBarHeight) + 1)
                esp.HealthBar.Visible  = healthEnabled and health > 0

                esp.HealthText.Text     = string.format("%d", math.floor(health))
                esp.HealthText.Position = Vector2.new(barPos.X - 10, barPos.Y + (barH - curBarHeight) - 7)
                esp.HealthText.Visible  = healthEnabled
            else
                espHideAll(p)
            end
        else
            espHideAll(p)
        end
    end
end)

