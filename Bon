local jumpEnabled    = false
local jumpStuds      = 25
local jitterSteps    = 5
local teleportDelay  = 0.01
local ACTION_JUMP    = "OrcaHub_JitterJumpAction"

local function doJitterJump(hum, root)
    if not hum or not root then return end
    if hum.FloorMaterial == Enum.Material.Air then return end
    local stepDistance = jumpStuds / jitterSteps
    for i = 1, jitterSteps do
        root.CFrame = root.CFrame + Vector3.new(0, stepDistance, 0)
        local shake = Vector3.new(math.random(-1,1)*0.2, 0, math.random(-1,1)*0.2)
        root.CFrame = root.CFrame + shake
        task.wait(teleportDelay)
    end
end

local function bindJump()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum  = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    hum.JumpPower = 0

    ContextActionService:BindAction(ACTION_JUMP, function(_, inputState, _)
        if inputState == Enum.UserInputState.Begin then
            doJitterJump(hum, root)
        end
    end, true, Enum.KeyCode.Space)

    -- Style mobile button
    local btn = ContextActionService:GetButton(ACTION_JUMP)
    if btn then
        btn.Size = UDim2.new(0, 100, 0, 100)
        btn.Text = "🐇"
        btn.TextSize = 45
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        btn.BackgroundTransparency = 0.4
        local corner = btn:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = btn
        local stroke = btn:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
        stroke.Thickness = 2
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 0.3
        stroke.Parent = btn
    end
end

local function unbindJump()
    ContextActionService:UnbindAction(ACTION_JUMP)
    local hum = getHumanoid()
    if hum then hum.JumpPower = 50 end -- restore Roblox default
end

